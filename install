#!/usr/bin/env bash
# ============================================================================
# Dotfiles 安装器 - 单一入口
# 直接运行 ./install 即可，无需记忆任何参数
# ============================================================================

# 获取脚本所在目录
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 如果用户提供了参数（向后兼容），使用完整功能脚本
if [ $# -gt 0 ]; then
    # 检查是否是求助信息
    case "$1" in
        -h|--help|help)
            echo "用法: ./install [选项]"
            echo ""
            echo "无参数运行:"
            echo "  ./install              启动智能安装向导（推荐）"
            echo ""
            echo "带参数运行（高级用户）:"
            echo "  ./install --help       显示所有可用参数"
            echo "  ./install --quick      快速安装"
            echo "  ./install --minimal    最小安装"
            echo ""
            echo "推荐: 直接运行 ./install 使用交互式向导"
            exit 0
            ;;
        *)
            # 传递给完整功能脚本
            if [ -f "$SCRIPT_DIR/scripts/install-unified.sh" ]; then
                exec "$SCRIPT_DIR/scripts/install-unified.sh" "$@"
            elif [ -f "$SCRIPT_DIR/scripts/install.original.sh" ]; then
                # 降级到原始脚本
                exec "$SCRIPT_DIR/scripts/install.original.sh" "$@"
            else
                echo "错误: 找不到安装脚本"
                exit 1
            fi
            ;;
    esac
fi

# 无参数时，启动智能向导
if [ -f "$SCRIPT_DIR/scripts/install-new.sh" ]; then
    exec "$SCRIPT_DIR/scripts/install-new.sh"
else
    echo "错误: 找不到安装向导脚本"
    echo "请确保 scripts/install-new.sh 存在"
    exit 1
fi
