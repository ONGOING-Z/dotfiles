#!/usr/bin/env zsh
# 优化版 zshrc 配置
# 性能优化重点：
# 1. 选择单一插件管理器
# 2. 延迟加载重型插件
# 3. 条件加载特定功能
# 4. 异步加载非关键组件

# ============================================================================
# 基础设置（必须首先加载）
# ============================================================================

# 跳过非交互式 shell
[[ $- != *i* ]] && return

# 性能分析（可选，设置 ZSH_PROFILE=1 启用）
[[ -f "$HOME/dotfiles/zsh/startup-profiling.zsh" ]] && source "$HOME/dotfiles/zsh/startup-profiling.zsh"

# 基础环境变量
export TERM="xterm-256color"
export EDITOR="${EDITOR:-vim}"
export LANG="${LANG:-en_US.UTF-8}"

# ============================================================================
# 插件管理器选择（只选一个）
# ============================================================================

# 使用环境变量控制插件管理器: ZSH_MANAGER=ohmyzsh|zplug|zinit|none
ZSH_MANAGER="${ZSH_MANAGER:-auto}"

# 自动检测可用的插件管理器
if [[ "$ZSH_MANAGER" == "auto" ]]; then
  if [[ -d "$HOME/.oh-my-zsh" ]]; then
    ZSH_MANAGER="ohmyzsh"
  elif [[ -f "$HOME/.zplug/init.zsh" ]]; then
    ZSH_MANAGER="zplug"
  elif [[ -f "$HOME/.zinit/bin/zinit.zsh" ]]; then
    ZSH_MANAGER="zinit"
  else
    ZSH_MANAGER="none"
  fi
fi

# ============================================================================
# Oh-My-Zsh 配置（轻量化）
# ============================================================================

if [[ "$ZSH_MANAGER" == "ohmyzsh" ]]; then
  export ZSH="$HOME/.oh-my-zsh"

  # 禁用自动更新检查（提升启动速度）
  DISABLE_AUTO_UPDATE=true

  # 简单主题（避免复杂主题影响性能）
  ZSH_THEME="robbyrussell"

  # 只加载必要插件
  plugins=(
    git           # 必需
    z             # 目录跳转
    extract       # 解压工具
  )

  # 延迟加载的插件
  # docker, kubectl, npm 等只在需要时加载

  source "$ZSH/oh-my-zsh.sh"
fi

# ============================================================================
# Zplug 配置（替代方案）
# ============================================================================

if [[ "$ZSH_MANAGER" == "zplug" ]]; then
  source "$HOME/.zplug/init.zsh"

  # 基础插件
  zplug "zsh-users/zsh-autosuggestions", defer:2
  zplug "zsh-users/zsh-syntax-highlighting", defer:2
  zplug "zsh-users/zsh-completions", defer:2

  # 主题
  zplug "themes/robbyrussell", from:oh-my-zsh

  # 安装插件
  if ! zplug check; then
    zplug install
  fi

  zplug load
fi

# ============================================================================
# 基础配置（所有管理器通用）
# ============================================================================

# Shell 选项
setopt EXTENDED_HISTORY       # 记录时间戳
setopt HIST_EXPIRE_DUPS_FIRST # 优先删除重复历史
setopt HIST_IGNORE_DUPS       # 忽略重复命令
setopt HIST_IGNORE_SPACE      # 忽略空格开头的命令
setopt HIST_VERIFY            # 历史展开后不立即执行
setopt SHARE_HISTORY          # 共享历史
setopt APPEND_HISTORY         # 追加历史
setopt INC_APPEND_HISTORY     # 立即追加
setopt AUTO_CD                # 自动 cd
setopt CORRECT                # 命令纠正

# 历史配置
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000

# ============================================================================
# 延迟加载配置
# ============================================================================

# 延迟加载 nvm（Node 版本管理）
if [[ -d "$HOME/.nvm" ]]; then
  lazy_load "$HOME/.nvm/nvm.sh" nvm node npm npx yarn
fi

# 延迟加载 rbenv（Ruby 版本管理）
if command -v rbenv &>/dev/null; then
  lazy_load <(rbenv init -) ruby gem bundle rake rails
fi

# 延迟加载 pyenv（Python 版本管理）
if command -v pyenv &>/dev/null; then
  lazy_load <(pyenv init -) python pip pipenv poetry
fi

# ============================================================================
# 条件加载配置
# ============================================================================

# Homebrew（仅在存在时加载）
if [[ "$OS_NAME" == "darwin" ]]; then
  [[ -f "/opt/homebrew/bin/brew" ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ "$OS_NAME" == "linux" ]]; then
  [[ -f "/home/linuxbrew/.linuxbrew/bin/brew" ]] && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# FZF（模糊查找）
if command -v fzf &>/dev/null; then
  # 基础配置
  export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'

  # 延迟加载键绑定和补全
  [[ -f ~/.fzf.zsh ]] && source ~/.fzf.zsh
fi

# Zoxide（更好的 cd）
if command -v zoxide &>/dev/null; then
  eval "$(zoxide init zsh --cmd z)"
fi

# ============================================================================
# 别名（轻量级）
# ============================================================================

# 基础别名
alias ll='ls -lah'
alias la='ls -A'
alias l='ls -CF'
alias ..='cd ..'
alias ...='cd ../..'

# Git 别名（仅基础）
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git pull'
alias gd='git diff'

# 条件别名
command -v batcat &>/dev/null && alias cat='batcat'
command -v bat &>/dev/null && alias cat='bat'

# ============================================================================
# 自定义函数（按需加载）
# ============================================================================

# 提取函数（延迟定义）
extract() {
  if [[ -f "$1" ]]; then
    case "$1" in
      *.tar.bz2) tar xjf "$1" ;;
      *.tar.gz) tar xzf "$1" ;;
      *.tar.xz) tar xJf "$1" ;;
      *.bz2) bunzip2 "$1" ;;
      *.rar) unrar e "$1" ;;
      *.gz) gunzip "$1" ;;
      *.tar) tar xf "$1" ;;
      *.tbz2) tar xjf "$1" ;;
      *.tgz) tar xzf "$1" ;;
      *.zip) unzip "$1" ;;
      *.Z) uncompress "$1" ;;
      *.7z) 7z x "$1" ;;
      *) echo "'$1' cannot be extracted" ;;
    esac
  else
    echo "'$1' is not a valid file"
  fi
}

# ============================================================================
# 本地配置（最后加载）
# ============================================================================

# 加载本地自定义配置（如果存在）
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# 加载 bash aliases（兼容性）
[[ -f "$HOME/.bash_aliases" ]] && source "$HOME/.bash_aliases"

# ============================================================================
# 清理和最终设置
# ============================================================================

# 显示性能分析结果（如果启用）
if [[ "${ZSH_PROFILE:-0}" == "1" ]] && command -v zprof &>/dev/null; then
  zprof
fi
