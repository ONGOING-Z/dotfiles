#!/usr/bin/env python3
"""
标准化目录命令 - 全局命令版本
调用 standardize_dirs.py 实现完整功能
"""

import os
import sys
from pathlib import Path

# 获取脚本所在目录
SCRIPT_DIR = Path(__file__).resolve().parent
MAIN_SCRIPT = SCRIPT_DIR / "standardize_dirs.py"


def main():
    """主函数 - 调用主脚本"""
    # 检查主脚本是否存在
    if not MAIN_SCRIPT.exists():
        print(f"❌ 错误: 找不到主脚本 {MAIN_SCRIPT}")
        print("请确保 standardize_dirs.py 在同一目录下")
        sys.exit(1)

    # 执行主脚本，传递所有参数
    import subprocess

    try:
        # 使用 subprocess 调用主脚本
        result = subprocess.run(
            [sys.executable, str(MAIN_SCRIPT)] + sys.argv[1:],
            cwd=os.getcwd(),
        )
        sys.exit(result.returncode)
    except KeyboardInterrupt:
        print("\n\n操作被用户中断")
        sys.exit(130)
    except Exception as e:
        print(f"\n❌ 程序执行出错: {str(e)}")
        sys.exit(1)


if __name__ == "__main__":
    main()
