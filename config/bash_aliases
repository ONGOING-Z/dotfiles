unalias idea 2>/dev/null
function idea() {
  if [ -d "$HOME/Applications/IntelliJ IDEA.app" ] || [ -d "/Applications/IntelliJ IDEA.app" ]; then
    open -na "IntelliJ IDEA.app" --args "$@"
  elif [ -d "$HOME/Applications/IntelliJ IDEA CE.app" ] || [ -d "/Applications/IntelliJ IDEA CE.app" ]; then
    open -na "IntelliJ IDEA CE.app" --args "$@"
  else
    echo "IntelliJ IDEA 未找到，请先安装或确认应用名称。"
    return 1
  fi
}
