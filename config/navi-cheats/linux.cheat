# Linux 系统管理备忘单

% linux, system, admin

# 查看系统信息
uname -a

# 查看 Linux 发行版信息
cat /etc/os-release

# 查看内核版本
uname -r

# 查看系统运行时间
uptime

# 查看当前用户
whoami

# 查看所有登录用户
who

# 查看最后登录的用户
last

# 查看系统负载
top

# 实时查看系统负载
htop

# 查看内存使用情况
free -h

# 查看磁盘使用情况
df -h

# 查看目录大小
du -sh <directory>

# 查看文件大小
ls -lh <file>

# 查找文件
find <directory> -name "<filename>"

# 按类型查找文件
find <directory> -type <file_type> -name "<pattern>"

# 查找并执行命令
find <directory> -name "<pattern>" -exec <command> {} \;

# 搜索文件内容
grep -r "<search_text>" <directory>

# 搜索文件内容（忽略大小写）
grep -ri "<search_text>" <directory>

# 查看进程
ps aux

# 查看特定进程
ps aux | grep <process_name>

# 杀死进程
kill <pid>

# 强制杀死进程
kill -9 <pid>

# 按名称杀死进程
killall <process_name>

# 查看端口占用
netstat -tulpn | grep <port>

# 查看网络连接
ss -tulpn

# 查看监听端口
lsof -i :<port>

# 创建目录
mkdir -p <directory_path>

# 删除文件
rm <file>

# 删除目录
rm -rf <directory>

# 复制文件
cp <source> <destination>

# 递归复制目录
cp -r <source_directory> <destination_directory>

# 移动/重命名文件
mv <source> <destination>

# 创建软链接
ln -s <target> <link_name>

# 查看文件权限
ls -la <file>

# 修改文件权限
chmod <permissions> <file>

# 修改文件所有者
chown <user>:<group> <file>

# 查看环境变量
env

# 设置环境变量
export <VAR_NAME>=<value>

# 查看 PATH 变量
echo $PATH

# 添加到 PATH
export PATH=$PATH:<new_path>

# 查看命令历史
history

# 清除命令历史
history -c

# 查看别名
alias

# 设置别名
alias <alias_name>='<command>'

# 压缩文件
tar -czf <archive_name>.tar.gz <directory>

# 解压文件
tar -xzf <archive_name>.tar.gz

# 创建 zip 压缩包
zip -r <archive_name>.zip <directory>

# 解压 zip 文件
unzip <archive_name>.zip

# 查看文件内容
cat <file>

# 分页查看文件内容
less <file>

# 查看文件头部
head -n <lines> <file>

# 查看文件尾部
tail -n <lines> <file>

# 实时查看文件尾部
tail -f <file>

# 计算文件行数
wc -l <file>

# 排序文件内容
sort <file>

# 去重文件内容
sort <file> | uniq

# 查看磁盘 I/O
iotop

# 查看网络流量
iftop

# 测试网络连通性
ping <host>

# 追踪网络路由
traceroute <host>

# 查看 DNS 解析
nslookup <domain>

# 下载文件
wget <url>

# 使用 curl 下载文件
curl -O <url>

# 查看系统服务状态
systemctl status <service_name>

# 启动系统服务
sudo systemctl start <service_name>

# 停止系统服务
sudo systemctl stop <service_name>

# 重启系统服务
sudo systemctl restart <service_name>

# 启用系统服务（开机自启）
sudo systemctl enable <service_name>

# 禁用系统服务
sudo systemctl disable <service_name>

# 查看系统日志
journalctl

# 查看特定服务日志
journalctl -u <service_name>

# 实时查看日志
journalctl -f

# 查看开机启动项
systemctl list-unit-files --type=service

# 查看 cron 任务
crontab -l

# 编辑 cron 任务
crontab -e

# 挂载设备
sudo mount <device> <mount_point>

# 卸载设备
sudo umount <mount_point>

# 查看挂载点
mount | grep <device>

# 同步文件系统
sync

# 重启系统
sudo reboot

# 关闭系统
sudo shutdown -h now

$ directory: find . -type d -name "*" | head -10
$ file: find . -type f -name "*" | head -20
$ process_name: ps aux --no-headers | awk '{print $11}' | sort | uniq | head -10
$ service_name: systemctl list-units --type=service --no-legend | awk '{print $1}' | sed 's/.service$//' | head -10
$ pid: ps aux --no-headers | awk '{print $2}' | head -10
$ port: echo -e "22\n80\n443\n3000\n5000\n8080\n8000\n9000"
$ file_type: echo -e "f\nd\nl"
$ permissions: echo -e "755\n644\n600\n777"
$ lines: echo -e "10\n20\n50\n100"