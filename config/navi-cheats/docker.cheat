# Docker 常用命令备忘单

% docker, container, devops

# 查看 Docker 版本
docker --version

# 查看 Docker 系统信息
docker system info

# 列出所有容器
docker ps -a

# 列出运行中的容器
docker ps

# 运行容器
docker run <image_name>

# 后台运行容器
docker run -d <image_name>

# 运行容器并映射端口
docker run -p <host_port>:<container_port> <image_name>

# 运行容器并挂载卷
docker run -v <host_path>:<container_path> <image_name>

# 交互式运行容器
docker run -it <image_name> /bin/bash

# 停止容器
docker stop <container_id>

# 强制停止容器
docker kill <container_id>

# 删除容器
docker rm <container_id>

# 强制删除容器
docker rm -f <container_id>

# 删除所有停止的容器
docker container prune

# 进入运行中的容器
docker exec -it <container_id> /bin/bash

# 查看容器日志
docker logs <container_id>

# 实时查看容器日志
docker logs -f <container_id>

# 查看容器资源使用情况
docker stats <container_id>

# 列出所有镜像
docker images

# 拉取镜像
docker pull <image_name>

# 构建镜像
docker build -t <image_name> .

# 从 Dockerfile 构建镜像
docker build -t <image_name> -f <dockerfile_path> .

# 删除镜像
docker rmi <image_id>

# 删除所有未使用的镜像
docker image prune

# 保存镜像为 tar 文件
docker save -o <output_file>.tar <image_name>

# 从 tar 文件加载镜像
docker load -i <input_file>.tar

# 给镜像打标签
docker tag <source_image> <target_image>

# 推送镜像到仓库
docker push <image_name>

# 搜索镜像
docker search <image_name>

# 查看镜像历史
docker history <image_name>

# 查看镜像详细信息
docker inspect <image_name>

# 创建网络
docker network create <network_name>

# 列出网络
docker network ls

# 删除网络
docker network rm <network_name>

# 查看网络详情
docker network inspect <network_name>

# 创建卷
docker volume create <volume_name>

# 列出卷
docker volume ls

# 删除卷
docker volume rm <volume_name>

# 查看卷详情
docker volume inspect <volume_name>

# 清理系统（删除未使用的容器、网络、镜像）
docker system prune

# 清理系统（包括卷）
docker system prune -a --volumes

# 查看 Docker 磁盘使用情况
docker system df

# 运行一次性容器（运行后自动删除）
docker run --rm <image_name>

# 设置容器环境变量
docker run -e <ENV_VAR>=<value> <image_name>

# 限制容器内存使用
docker run -m <memory_limit> <image_name>

# 限制容器 CPU 使用
docker run --cpus="<cpu_count>" <image_name>

# 复制文件到容器
docker cp <local_path> <container_id>:<container_path>

# 从容器复制文件
docker cp <container_id>:<container_path> <local_path>

# 导出容器为 tar 文件
docker export <container_id> > <output_file>.tar

# 从 tar 文件导入容器
docker import <input_file>.tar <image_name>

# 暂停容器
docker pause <container_id>

# 恢复容器
docker unpause <container_id>

# 重启容器
docker restart <container_id>

# 查看容器端口映射
docker port <container_id>

# 查看容器进程
docker top <container_id>

$ image_name: docker images --format "table {{.Repository}}:{{.Tag}}" | tail -n +2
$ container_id: docker ps -a --format "table {{.ID}}\t{{.Names}}" | tail -n +2 | awk '{print $1}'
$ network_name: docker network ls --format "table {{.Name}}" | tail -n +2
$ volume_name: docker volume ls --format "table {{.Name}}" | tail -n +2
$ host_port: echo -e "80\n443\n3000\n5000\n8080\n8000\n9000"
$ container_port: echo -e "80\n443\n3000\n5000\n8080\n8000\n9000"
$ memory_limit: echo -e "128m\n256m\n512m\n1g\n2g"
$ cpu_count: echo -e "0.5\n1.0\n1.5\n2.0"