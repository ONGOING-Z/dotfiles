{
  "theme": "dark-ansi",
  "fileSuggestion": {
    "type": "command",
    "command": "~/.claude/file-suggestion.sh"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.js"
  },
  "permissions": {
    "allow": [
      "Bash(shellcheck install *)",
      "Bash(git submodule *)"
    ],
    "deny": [
      "Bash(mysql *)",
      "Bash(psql *)",
      "Bash(sqlite3 *)",
      "Bash(mongo *)"
    ]
  }
}
